@page "/atletas"
@inject MembersViewModel VM
@inject NavigationManager Navigation

<h1>Atletas</h1>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="() => VM.NewCommand.Execute(null)">Nuevo atleta</button>
    <span class="ms-3">
        <input type="checkbox" class="form-check-input" id="show-inactive"
               @bind="VM.ShowInactive" @bind:after="() => VM.LoadCommand.ExecuteAsync(null)" />
        <label class="form-check-label" for="show-inactive">Mostrar inactivos</label>
    </span>
</div>

@if (VM.IsEditing)
{
    <div class="card mb-3">
        <div class="card-header"><h2 class="app-card-title">@VM.FormTitle</h2></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="m-firstname">Nombre *</label>
                    <input id="m-firstname" class="form-control" @bind="VM.Editing.FirstName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="m-lastname">Apellido *</label>
                    <input id="m-lastname" class="form-control" @bind="VM.Editing.LastName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="m-birthdate">Fecha de nacimiento</label>
                    <input id="m-birthdate" class="form-control" type="date" @bind="VM.Editing.BirthDate" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="m-gender">Género</label>
                    <select id="m-gender" class="form-select" @bind="VM.Editing.Gender">
                        @foreach (var option in VM.GenderOptions)
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="m-belt">Grado</label>
                    <select id="m-belt" class="form-select" @bind="VM.Editing.BeltGrade">
                        @foreach (var option in VM.BeltOptions)
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="m-weight">Peso actual (kg)</label>
                    <input id="m-weight" class="form-control" type="number" step="0.1" @bind="VM.Editing.ActualWeightKg" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="m-category">Categoría de peso IJF</label>
                    <select id="m-category" class="form-select" @bind="VM.Editing.WeightCategory">
                        <optgroup label="Masculino">
                            @foreach (var option in VM.MenWeightOptions)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </optgroup>
                        <optgroup label="Femenino">
                            @foreach (var option in VM.WomenWeightOptions)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }
                        </optgroup>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Foto de perfil</label>
                    <div>
                        @if (VM.PhotoPreview is not null)
                        {
                            <img src="@VM.PhotoPreview" alt="Foto de perfil" style="max-height: 8rem;" class="mb-2 d-block" />
                        }
                        <button class="btn btn-outline-secondary me-2" @onclick="() => VM.TakePhotoCommand.ExecuteAsync(null)">Tomar foto</button>
                        <button class="btn btn-outline-danger" disabled="@(VM.Editing.PhotoFilePath is null)"
                                @onclick="() => VM.RemovePhotoCommand.ExecuteAsync(null)">Quitar foto</button>
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="m-contact">Contacto de emergencia</label>
                    <input id="m-contact" class="form-control" @bind="VM.Editing.EmergencyContactName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="m-contactphone">Teléfono de emergencia</label>
                    <input id="m-contactphone" class="form-control" @bind="VM.Editing.EmergencyContactPhone" />
                </div>
                <div class="col-md-12">
                    <label class="form-label" for="m-medical">Ficha médica de emergencia (alergias, lesiones, medicación)</label>
                    <textarea id="m-medical" class="form-control" rows="3" @bind="VM.Editing.MedicalNotes"></textarea>
                </div>
            </div>
            <div class="mt-3">
                <button class="btn btn-primary me-2" @onclick="() => VM.SaveCommand.ExecuteAsync(null)">Guardar</button>
                <button class="btn btn-outline-secondary" @onclick="() => VM.CancelCommand.Execute(null)">Cancelar</button>
            </div>
        </div>
    </div>
}

@if (VM.IsBusy)
{
    <p><em>Cargando...</em></p>
}
else if (VM.Members.Count == 0)
{
    <p>No hay atletas cargados todavía.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Atleta</th>
                    <th>Grado</th>
                    <th>Categoría</th>
                    <th>Peso</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
        <tbody>
            @foreach (var member in VM.Members)
            {
                <tr>
                    <td>@member.LastName, @member.FirstName</td>
                    <td>@VM.BeltLabel(member.BeltGrade)</td>
                    <td>@VM.WeightLabel(member.WeightCategory)</td>
                    <td>@(member.ActualWeightKg is null ? "—" : member.ActualWeightKg.Value.ToString("0.0") + " kg")</td>
                    <td>
                        @if (member.IsActive)
                        {
                            <span class="badge text-bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => VM.EditCommand.Execute(member)">Editar</button>
                        <button class="btn btn-sm btn-outline-warning" @onclick="() => VM.ToggleActiveCommand.ExecuteAsync(member)">
                            @(member.IsActive ? "Desactivar" : "Reactivar")
                        </button>
                    </td>
                </tr>
            }
        </tbody>
        </table>
    </div>
}

@if (!string.IsNullOrEmpty(VM.StatusMessage))
{
    <div class="app-alert @(VM.StatusIsError ? "app-alert-danger" : "app-alert-success")" role="alert">
        <span class="app-alert-icon" aria-hidden="true"></span>
        <span><strong class="app-alert-label">@(VM.StatusIsError ? "Error." : "Correcto.")</strong> @VM.StatusMessage</span>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        if (!VM.HasSelectedClub)
        {
            Navigation.NavigateTo("");
            return;
        }

        await VM.LoadCommand.ExecuteAsync(null);
    }
}
