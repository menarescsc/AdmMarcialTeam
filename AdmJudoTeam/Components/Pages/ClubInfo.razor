@page "/club"
@page "/club/nuevo"
@inject ClubViewModel VM
@inject NavigationManager Navigation

<h1>Club / Dojo</h1>

@if (VM.IsBusy)
{
    <p><em>Cargando...</em></p>
}
else
{
    <section class="club-logo-section" aria-labelledby="club-logo-title">
        <h2 id="club-logo-title">Logo del club</h2>
        <div class="club-logo-chip">
            @if (!string.IsNullOrEmpty(VM.LogoPreview))
            {
                <img class="club-logo-image" src="@VM.LogoPreview" alt="Logo del club" />
            }
            else
            {
                <div class="club-logo-placeholder">
                    <svg class="club-logo-placeholder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="14" rx="2" />
                        <circle cx="8.5" cy="10" r="1.5" />
                        <path d="M21 16l-5-5-6 6-2-2-5 5" />
                    </svg>
                    <span>Sin logo</span>
                </div>
            }
        </div>
        <div class="club-logo-actions">
            <button class="btn btn-outline-secondary" @onclick="() => VM.PickLogoCommand.ExecuteAsync(null)">Elegir imagen</button>
            <button class="btn btn-outline-secondary" @onclick="() => VM.CaptureLogoCommand.ExecuteAsync(null)">Tomar foto</button>
            @if (!string.IsNullOrEmpty(VM.Editing.LogoPath))
            {
                <button class="btn btn-outline-danger" @onclick="() => VM.RemoveLogoCommand.ExecuteAsync(null)">Quitar logo</button>
            }
        </div>
    </section>

    <h2>@VM.FormTitle</h2>

    @if (VM.IsNew)
    {
        <div class="app-alert app-alert-info" role="alert">
            <span class="app-alert-icon" aria-hidden="true"></span>
            <span><strong class="app-alert-label">Aviso.</strong> Complete los datos del club o dojo para comenzar a usar la aplicación.</span>
        </div>
    }

    <div class="mb-3" style="max-width: 32rem;">
        <label class="form-label" for="club-name">Nombre *</label>
        <input id="club-name" class="form-control" @bind="VM.Editing.Name" />
    </div>
    <div class="mb-3" style="max-width: 32rem;">
        <label class="form-label" for="club-address">Dirección</label>
        <input id="club-address" class="form-control" @bind="VM.Editing.Address" />
    </div>
    <div class="mb-3" style="max-width: 32rem;">
        <label class="form-label" for="club-phone">Teléfono</label>
        <input id="club-phone" class="form-control" @bind="VM.Editing.Phone" />
    </div>
    <div class="mb-3" style="max-width: 32rem;">
        <label class="form-label" for="club-email">Correo electrónico</label>
        <input id="club-email" class="form-control" type="email" @bind="VM.Editing.Email" />
    </div>

    <button class="btn btn-primary" @onclick="SaveAsync">Guardar</button>

    @if (!VM.IsNew)
    {
        <section class="club-danger-zone" aria-labelledby="club-danger-title">
            <h2 id="club-danger-title">Zona de eliminación</h2>
            <p class="club-danger-note">Elimine el club y todos sus datos de forma permanente.</p>
            @if (!VM.IsConfirmingDelete)
            {
                <button type="button" class="btn btn-outline-danger" @onclick="() => VM.AskDeleteCommand.Execute(null)">Eliminar club</button>
            }
            else
            {
                <div class="app-alert app-alert-danger club-delete-confirm" role="alert">
                    <span class="app-alert-icon" aria-hidden="true"></span>
                    <div class="club-delete-confirm-body">
                        <h3 class="app-alert-label club-delete-confirm-title">Eliminar club</h3>
                        <p class="club-delete-confirm-text">¿Eliminar «@VM.Editing.Name» y todos sus datos? Esta acción no se puede deshacer.</p>
                        <div class="club-delete-confirm-actions">
                            <button type="button" class="btn btn-danger" disabled="@VM.IsBusy" @onclick="ConfirmDeleteAsync">Sí, eliminar</button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => VM.CancelDeleteCommand.Execute(null)">Cancelar</button>
                        </div>
                    </div>
                </div>
            }
        </section>
    }
}

@if (!string.IsNullOrEmpty(VM.StatusMessage))
{
    <div class="app-alert @(VM.StatusIsError ? "app-alert-danger" : "app-alert-success")" role="alert">
        <span class="app-alert-icon" aria-hidden="true"></span>
        <span><strong class="app-alert-label">@(VM.StatusIsError ? "Error." : "Correcto.")</strong> @VM.StatusMessage</span>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        // /club/nuevo always creates a club (also the mandatory first record);
        // /club edits the selected club and requires a club selection.
        var isCreateRoute = Navigation.ToBaseRelativePath(Navigation.Uri)
            .StartsWith("club/nuevo", StringComparison.OrdinalIgnoreCase);

        if (isCreateRoute)
        {
            await VM.LoadCommand.ExecuteAsync(null);
            return;
        }

        if (!VM.HasSelectedClub)
        {
            Navigation.NavigateTo("");
            return;
        }

        await VM.LoadCommand.ExecuteAsync(VM.SelectedClubId);
    }

    private async Task SaveAsync()
    {
        await VM.SaveCommand.ExecuteAsync(null);

        if (VM.SavedNewClub)
        {
            // A newly created club becomes the active club context (done by the
            // ViewModel); open its panel right away.
            Navigation.NavigateTo("panel");
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        await VM.DeleteClubCommand.ExecuteAsync(null);

        if (VM.Deleted)
        {
            // Back to the club selector. If this was the last club, Home forces
            // the club creation route automatically.
            Navigation.NavigateTo("");
        }
    }
}
