@page "/panel"
@inject ClubPanelViewModel VM
@inject NavigationManager Navigation

<h1>Panel del club</h1>

@if (VM.IsBusy)
{
    <p><em>Cargando...</em></p>
}
else
{
    <section class="panel-hero" aria-labelledby="panel-club-name">
        @if (!string.IsNullOrEmpty(VM.ClubLogoPreview))
        {
            <img class="panel-hero-logo" src="@VM.ClubLogoPreview" alt="Logo del club" />
        }
        <div class="panel-hero-text">
            <h2 id="panel-club-name" class="panel-hero-name">@VM.ClubName</h2>
            @if (!string.IsNullOrWhiteSpace(VM.ClubAddress))
            {
                <p class="panel-hero-address">@VM.ClubAddress</p>
            }
        </div>
    </section>

    <section class="panel-stats" aria-label="Resumen del club">
        <div class="panel-stat panel-stat--atletas">
            <span class="panel-stat-value">@VM.ActiveAthleteCount</span>
            <span class="panel-stat-label">Atletas activos</span>
        </div>
        <div class="panel-stat panel-stat--torneos">
            <span class="panel-stat-value">@VM.TournamentCount</span>
            <span class="panel-stat-label">Competencias</span>
        </div>
    </section>

    <section class="panel-section" aria-labelledby="panel-actions-title">
        <h2 id="panel-actions-title">Gestión del club</h2>
        <div class="panel-actions-grid">
            <a class="panel-action-card panel-action-card--atletas" href="atletas">
                <span class="panel-action-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="8" r="3.25" />
                        <path d="M3.5 19c0-3 2.5-5 5.5-5s5.5 2 5.5 5" />
                        <circle cx="17" cy="9" r="2.5" />
                        <path d="M16 14.2c2.6.3 4.5 2.2 4.5 4.8" />
                    </svg>
                </span>
                <h3 class="panel-action-title">Atletas</h3>
                <p class="panel-action-text">Fichas, grados y categorías de peso.</p>
            </a>
            <a class="panel-action-card panel-action-card--torneos" href="torneos">
                <span class="panel-action-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3.5" y="5" width="17" height="15" rx="2" />
                        <line x1="3.5" y1="9.5" x2="20.5" y2="9.5" />
                        <line x1="8" y1="3" x2="8" y2="6.5" />
                        <line x1="16" y1="3" x2="16" y2="6.5" />
                    </svg>
                </span>
                <h3 class="panel-action-title">Competencias</h3>
                <p class="panel-action-text">Inscripciones, pesajes y nómina oficial.</p>
            </a>
            <a class="panel-action-card panel-action-card--tatami" href="tatami">
                <span class="panel-action-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="13.5" r="7.5" />
                        <line x1="12" y1="9.5" x2="12" y2="13.5" />
                        <line x1="12" y1="13.5" x2="15" y2="15.5" />
                        <line x1="10" y1="2.5" x2="14" y2="2.5" />
                        <line x1="12" y1="2.5" x2="12" y2="6" />
                    </svg>
                </span>
                <h3 class="panel-action-title">Modo Tatami</h3>
                <p class="panel-action-text">Asistencia y temporizador de rondas.</p>
            </a>
            <a class="panel-action-card panel-action-card--club" href="club">
                <span class="panel-action-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2.5 20 5.5v6c0 4.7-3.2 8.3-8 10-4.8-1.7-8-5.3-8-10v-6z" />
                    </svg>
                </span>
                <h3 class="panel-action-title">Datos del club</h3>
                <p class="panel-action-text">Identidad y datos de contacto del club.</p>
            </a>
        </div>
    </section>
}

@if (!string.IsNullOrEmpty(VM.StatusMessage))
{
    <div class="app-alert @(VM.StatusIsError ? "app-alert-danger" : "app-alert-success")" role="alert">
        <span class="app-alert-icon" aria-hidden="true"></span>
        <span><strong class="app-alert-label">@(VM.StatusIsError ? "Error." : "Correcto.")</strong> @VM.StatusMessage</span>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        if (!VM.HasSelectedClub)
        {
            Navigation.NavigateTo("");
            return;
        }

        await VM.LoadCommand.ExecuteAsync(null);
    }
}
