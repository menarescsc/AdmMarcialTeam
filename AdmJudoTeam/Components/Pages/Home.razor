@page "/"
@inject HomeViewModel VM
@inject NavigationManager Navigation

<h1>Mis clubes</h1>

<p class="home-lead">Seleccione un club para gestionar sus atletas, competencias y entrenamientos.</p>

@if (VM.IsBusy)
{
    <p><em>Cargando...</em></p>
}
else
{
    <section aria-labelledby="home-clubs-title">
        <h2 id="home-clubs-title" class="visually-hidden">Clubes registrados</h2>
        <ul class="home-clubs-list" role="list">
            @foreach (var club in VM.Clubs)
            {
                <li>
                    <button type="button" class="club-card" @onclick="() => OpenClubAsync(club.Id)">
                        @if (!string.IsNullOrEmpty(club.LogoPreview))
                        {
                            <img class="club-card-logo" src="@club.LogoPreview" alt="Logo de @club.Name" />
                        }
                        else
                        {
                            <span class="club-card-logo club-card-logo--placeholder" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 2.5 20 5.5v6c0 4.7-3.2 8.3-8 10-4.8-1.7-8-5.3-8-10v-6z" />
                                </svg>
                            </span>
                        }
                        <span class="club-card-body">
                            <span class="club-card-name">@club.Name</span>
                            @if (!string.IsNullOrWhiteSpace(club.Address))
                            {
                                <span class="club-card-address">@club.Address</span>
                            }
                        </span>
                        <span class="club-card-chevron" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 6l6 6-6 6" />
                            </svg>
                        </span>
                    </button>
                </li>
            }
        </ul>

        <a class="btn btn-primary home-add-club" href="club/nuevo">
            <svg class="home-add-club-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            Agregar club
        </a>
    </section>
}

<p class="home-offline-note">
    <svg class="home-offline-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="3" x2="21" y2="21" />
        <path d="M9.5 15.5a4 4 0 0 1 5 0" />
        <line x1="12" y1="19" x2="12.01" y2="19" />
        <path d="M6 12.5a9 9 0 0 1 3-2" />
        <path d="M15 10.5a9 9 0 0 1 3 2" />
        <path d="M2.5 9a14 14 0 0 1 4.5-2.8" />
        <path d="M17 6.2a14 14 0 0 1 4.5 2.8" />
    </svg>
    Funciona sin conexión.
</p>

@if (!string.IsNullOrEmpty(VM.StatusMessage))
{
    <div class="app-alert @(VM.StatusIsError ? "app-alert-danger" : "app-alert-success")" role="alert">
        <span class="app-alert-icon" aria-hidden="true"></span>
        <span><strong class="app-alert-label">@(VM.StatusIsError ? "Error." : "Correcto.")</strong> @VM.StatusMessage</span>
    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        await VM.LoadCommand.ExecuteAsync(null);

        if (!VM.AnyClubRegistered)
        {
            // The club is the mandatory first record: force its registration before anything else.
            Navigation.NavigateTo("club/nuevo");
        }
    }

    private void OpenClubAsync(int clubId)
    {
        VM.SelectClubCommand.Execute(clubId);
        Navigation.NavigateTo("panel");
    }
}
