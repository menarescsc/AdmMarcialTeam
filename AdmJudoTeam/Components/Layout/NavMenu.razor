@implements IDisposable
@inject ClubSwitcherViewModel VM
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">AdmJudoTeam</a>
    </div>
</div>

<input type="checkbox" title="Menú de navegación" class="navbar-toggler" />

<!-- Native inline handler (template pattern): any click inside the sidebar collapses the mobile drawer.
     Skip the switcher toggle so expanding/collapsing the club list keeps the drawer open.
     Club rows and nav links still close it because they navigate. Note: Blazor's @onclick:stopPropagation
     cannot suppress this ancestor inline handler (it runs later, at the document-level delegation). -->
<div class="nav-scrollable" onclick="if(!event.target.closest('.club-switcher-toggle')) document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @if (VM.HasClubs)
        {
            <section class="club-switcher" aria-label="Cambiar de club">
                <button type="button" class="club-switcher-toggle"
                        aria-expanded="@(VM.IsExpanded ? "true" : "false")"
                        aria-controls="club-switcher-list"
                        @onclick="() => VM.ToggleExpandedCommand.Execute(null)">
                    @if (!string.IsNullOrEmpty(VM.SelectedClub?.LogoPreview))
                    {
                        <img class="club-switcher-logo" src="@VM.SelectedClub!.LogoPreview" alt="" />
                    }
                    else
                    {
                        <span class="club-switcher-logo club-switcher-logo--placeholder" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2.5 20 5.5v6c0 4.7-3.2 8.3-8 10-4.8-1.7-8-5.3-8-10v-6z" />
                            </svg>
                        </span>
                    }
                    <span class="club-switcher-name">@(VM.SelectedClub?.Name ?? "Seleccionar club")</span>
                    <svg class="club-switcher-chevron @(VM.IsExpanded ? "club-switcher-chevron--expanded" : "")"
                         viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M6 9l6 6 6-6" />
                    </svg>
                </button>
                @if (VM.IsExpanded)
                {
                    <ul id="club-switcher-list" class="club-switcher-list" role="list">
                        @foreach (var club in VM.Clubs)
                        {
                            var isActive = club.Id == VM.SelectedClubId;
                            <li>
                                <button type="button"
                                        class="club-switcher-row @(isActive ? "club-switcher-row--active" : "")"
                                        aria-current="@(isActive ? "true" : null)"
                                        @onclick="() => VM.SelectClubCommand.Execute(club.Id)">
                                    @if (!string.IsNullOrEmpty(club.LogoPreview))
                                    {
                                        <img class="club-switcher-logo" src="@club.LogoPreview" alt="" />
                                    }
                                    else
                                    {
                                        <span class="club-switcher-logo club-switcher-logo--placeholder" aria-hidden="true">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                                 stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M12 2.5 20 5.5v6c0 4.7-3.2 8.3-8 10-4.8-1.7-8-5.3-8-10v-6z" />
                                            </svg>
                                        </span>
                                    }
                                    <span class="club-switcher-row-name">@club.Name</span>
                                    @if (isActive)
                                    {
                                        <svg class="club-switcher-check" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M5 12.5l4.5 4.5L19 7.5" />
                                        </svg>
                                        <span class="visually-hidden">Club activo</span>
                                    }
                                </button>
                            </li>
                        }
                    </ul>
                    <div class="club-switcher-footer">
                        <a class="club-switcher-action" href="">Administrar clubes</a>
                        <a class="club-switcher-action" href="club/nuevo">Agregar club</a>
                    </div>
                }
            </section>
        }
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Clubes
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="club">
                <span class="bi bi-shield-nav-menu" aria-hidden="true"></span> Club
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="atletas">
                <span class="bi bi-people-nav-menu" aria-hidden="true"></span> Atletas
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="torneos">
                <span class="bi bi-calendar-nav-menu" aria-hidden="true"></span> Torneos
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="tatami">
                <span class="bi bi-stopwatch-nav-menu" aria-hidden="true"></span> Modo Tatami
            </NavLink>
        </div>
    </nav>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocationChanged;
        await VM.ReloadCommand.ExecuteAsync(null);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // NavMenu stays alive across navigations: collapse the switcher and
        // reload the club list so clubs added or deleted on other screens are
        // reflected here.
        _ = InvokeAsync(async () =>
        {
            VM.Collapse();
            await VM.ReloadCommand.ExecuteAsync(null);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
